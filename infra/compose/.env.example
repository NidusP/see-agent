POSTGRES_DB=see_agent
POSTGRES_USER=see_agent
POSTGRES_PASSWORD=see_agent_dev

MINIO_ROOT_USER=see_agent
MINIO_ROOT_PASSWORD=see_agent_dev

SEE_AGENT_POSTGRES_PORT=15432
SEE_AGENT_REDIS_PORT=16379
SEE_AGENT_MINIO_API_PORT=19000
SEE_AGENT_MINIO_CONSOLE_PORT=19001
SEE_AGENT_QDRANT_HTTP_PORT=16333
SEE_AGENT_QDRANT_GRPC_PORT=16334

QDRANT_URL=http://localhost:16333
QDRANT_COLLECTION=see_agent_dense_qwen_chunks_v1
QDRANT_TIMEOUT_SECONDS=5
# Local fullstack semantic retrieval. Native dense is the sole product profile;
# historical lexical evidence remains audit-only and cannot be reactivated.
RUNTIME_RETRIEVAL_STRATEGY=native_dense_v1
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=30
AI_RUNTIME_BASE_URL=http://127.0.0.1:8000
REDIS_URL=redis://localhost:16379/0
REDIS_INGESTION_QUEUE=see_agent:ingestion
AUTH_SESSION_STORE=redis
REDIS_SESSION_PREFIX=see_agent:session:
DATABASE_URL=postgres://see_agent:see_agent_dev@localhost:15432/see_agent?sslmode=disable
OBJECT_STORE_ENDPOINT=http://localhost:19000
OBJECT_STORE_BUCKET=knowledge-docs
OBJECT_STORE_ACCESS_KEY=see_agent
OBJECT_STORE_SECRET_KEY=see_agent_dev
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_TIMEOUT_SECONDS=10

LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_PROVIDER=ollama_native
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_DEFAULT_MODEL_ID=qwen3:14b
LOCAL_LLM_TIMEOUT_SECONDS=90
# Runtime performs one internal, non-persistent generation warm-up before it
# declares ready in fullstack_dev/production. Backend must allow enough time
# for normal model calls while remaining below this provider-side budget.
BACKEND_RUNTIME_CHAT_TIMEOUT_SECONDS=60
LOCAL_LLM_ALLOW_FALLBACK=false
SEE_AGENT_PROFILE=fullstack_dev
# Load this secret from a local, permission-restricted file or deployment secret injection.
# It must be at least 32 characters and must never be committed to this template.
SEE_AGENT_RUNTIME_SERVICE_TOKEN=
K3_DELIVERY_ENABLED=true
SEE_AGENT_SYSTEM_ADMIN_USERNAME=admin
SEE_AGENT_SYSTEM_ADMIN_PASSWORD=admin123
SEE_AGENT_KNOWLEDGE_ADMIN_USERNAME=knowledge_admin
SEE_AGENT_KNOWLEDGE_ADMIN_PASSWORD=knowledge_admin123
SEE_AGENT_USER_USERNAME=user
SEE_AGENT_USER_PASSWORD=user123
