{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://see-agent.local/contracts/chat-runtime-strict-request.schema.json",
  "title": "StrictChatRuntimeRequest",
  "description": "F0 target contract. F2 promotes this to the only product Runtime request schema; test-only factories may use a separate fixture contract.",
  "type": "object",
  "required": [
    "request_id",
    "conversation_id",
    "message_id",
    "user_query",
    "model_id",
    "config_version",
    "retrieval_config_version",
    "answer_mode",
    "intent",
    "stream",
    "messages"
  ],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "conversation_id": {"type": "string", "minLength": 1},
    "message_id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "user_query": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "config_version": {"type": "string", "minLength": 1},
    "retrieval_config_version": {"type": "string", "minLength": 1},
    "answer_mode": {"type": "string", "enum": ["normal", "revalidate"]},
    "intent": {
      "type": "string",
      "enum": ["context_routing_required", "knowledge_query", "social_greeting", "social_thanks", "social_farewell", "capability_help", "off_topic", "out_of_scope"]
    },
    "answer_policy_version": {"type": "string", "enum": ["answer_policy_v1", "answer_policy_v2", "answer_policy_v3", "answer_policy_v4", "answer_policy_v5"]},
    "pending_clarification": {"$ref": "#/$defs/PendingClarification"},
    "knowledge_scope": {"$ref": "#/$defs/KnowledgeScope"},
    "revalidation_context": {"$ref": "#/$defs/RevalidationContext"},
    "stream": {"type": "boolean"},
    "messages": {"type": "array", "items": {"$ref": "#/$defs/ConversationMessage"}},
    "source_filters": {"$ref": "#/$defs/SourceFilters"},
    "response_overrides": {"$ref": "#/$defs/ResponseOverrides"}
  },
  "allOf": [
    {
      "if": {"properties": {"intent": {"const": "knowledge_query"}}, "required": ["intent"]},
      "then": {"required": ["knowledge_scope"]}
    },
    {
      "if": {"properties": {"answer_mode": {"const": "revalidate"}}, "required": ["answer_mode"]},
      "then": {"required": ["knowledge_scope", "revalidation_context"]}
    },
    {
      "if": {
        "properties": {"intent": {"enum": ["context_routing_required", "social_greeting", "social_thanks", "social_farewell", "capability_help", "off_topic", "out_of_scope"]}},
        "required": ["intent"]
      },
      "then": {"not": {"required": ["knowledge_scope"]}}
    },
    {
      "if": {"required": ["answer_policy_version"]},
      "then": {"properties": {"intent": {"enum": ["context_routing_required", "knowledge_query"]}}}
    },
    {
      "if": {"required": ["pending_clarification"]},
      "then": {
        "required": ["answer_policy_version"],
        "properties": {"intent": {"enum": ["context_routing_required", "knowledge_query"]}}
      }
    },
    {
      "if": {"required": ["answer_policy_version"], "properties": {"answer_policy_version": {"const": "answer_policy_v1"}}},
      "then": {
        "required": ["response_overrides"],
        "properties": {
          "response_overrides": {
            "required": ["system_prompt_version"],
            "properties": {"system_prompt_version": {"const": "prompt_v8"}}
          }
        }
      }
    },
    {
      "if": {"required": ["answer_policy_version"], "properties": {"answer_policy_version": {"const": "answer_policy_v2"}}},
      "then": {
        "required": ["response_overrides"],
        "properties": {
          "response_overrides": {
            "required": ["system_prompt_version"],
            "properties": {"system_prompt_version": {"const": "prompt_v9"}}
          }
        }
      }
    },
    {
      "if": {"required": ["answer_policy_version"], "properties": {"answer_policy_version": {"const": "answer_policy_v3"}}},
      "then": {
        "required": ["response_overrides"],
        "properties": {
          "response_overrides": {
            "required": ["system_prompt_version"],
            "properties": {"system_prompt_version": {"const": "prompt_v10"}}
          }
        }
      }
    },
    {
      "if": {"required": ["answer_policy_version"], "properties": {"answer_policy_version": {"const": "answer_policy_v4"}}},
      "then": {
        "required": ["response_overrides"],
        "properties": {
          "response_overrides": {
            "required": ["system_prompt_version"],
            "properties": {"system_prompt_version": {"const": "prompt_v11"}}
          }
        }
      }
    },
    {
      "if": {"required": ["answer_policy_version"], "properties": {"answer_policy_version": {"const": "answer_policy_v5"}}},
      "then": {
        "required": ["response_overrides"],
        "properties": {
          "response_overrides": {
            "required": ["system_prompt_version"],
            "properties": {"system_prompt_version": {"const": "prompt_v12"}}
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "KnowledgeScope": {
      "type": "object",
      "required": ["snapshot_id", "manifest_hash", "revision_ids", "resolved_at"],
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1},
        "manifest_hash": {"type": "string", "minLength": 1},
        "revision_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "resolved_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "RevalidationContext": {
      "type": "object",
      "required": ["original_message_id", "original_snapshot_id", "original_answer", "original_citation_revision_ids", "related_update_event_ids"],
      "properties": {
        "original_message_id": {"type": "string", "minLength": 1},
        "original_snapshot_id": {"type": "string", "minLength": 1},
        "original_answer": {"type": "string", "minLength": 1},
        "original_citation_revision_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "related_update_event_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "PendingClarification": {
      "type": "object",
      "required": ["clarification_id", "state_version", "original_user_message_id", "original_query", "missing_dimensions", "question", "turn_count"],
      "properties": {
        "clarification_id": {"type": "string", "minLength": 1},
        "state_version": {"type": "integer", "minimum": 1},
        "original_user_message_id": {"type": "string", "minLength": 1},
        "original_query": {"type": "string", "minLength": 1, "maxLength": 600},
        "missing_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "question": {"type": "string", "minLength": 1, "maxLength": 600},
        "turn_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "ConversationMessage": {
      "type": "object",
      "required": ["message_id", "role", "content"],
      "properties": {
        "message_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "enum": ["system", "user", "assistant"]},
        "content": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "SourceFilters": {
      "type": "object",
      "properties": {
        "file_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "source_formats": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["txt", "md", "json", "pdf", "docx", "xlsx", "pptx"]}}
      },
      "additionalProperties": false
    },
    "ResponseOverrides": {
      "type": "object",
      "properties": {
        "system_prompt_version": {"type": "string", "enum": ["prompt_v1", "prompt_v2", "prompt_v3", "prompt_v4", "prompt_v5", "prompt_v6", "prompt_v7", "prompt_v8", "prompt_v9", "prompt_v10", "prompt_v11", "prompt_v12"]},
        "response_style": {"type": "string", "minLength": 1},
        "temperature": {"type": "number"},
        "top_p": {"type": "number", "minimum": 0, "maximum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "top_k": {"type": "integer", "minimum": 1},
        "retrieval_strategy": {"type": "string", "minLength": 1},
        "embedding_model": {"type": "string", "minLength": 1},
        "rerank_enabled": {"type": "boolean"},
        "evidence_min_score": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  }
}
