{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://see-agent.local/contracts/chat-runtime-request.schema.json",
  "title": "ChatRuntimeRequest",
  "type": "object",
  "required": [
    "request_id",
    "conversation_id",
    "message_id",
    "user_query",
    "model_id",
    "config_version",
    "retrieval_config_version",
    "knowledge_snapshot_id",
    "stream",
    "messages"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "message_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_query": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string"
    },
    "config_version": {
      "type": "string"
    },
    "retrieval_config_version": {
      "type": "string"
    },
    "knowledge_snapshot_id": {
      "type": "string"
    },
    "knowledge_scope": {
      "$ref": "#/$defs/KnowledgeScope"
    },
    "answer_mode": {
      "type": "string",
      "enum": ["normal", "revalidate"],
      "default": "normal"
    },
    "intent": {
      "type": "string",
      "enum": ["context_routing_required", "knowledge_query", "social_greeting", "social_thanks", "social_farewell", "capability_help", "off_topic", "out_of_scope"],
      "default": "knowledge_query"
    },
    "answer_policy_version": {
      "type": "string",
      "enum": ["answer_policy_v1", "answer_policy_v2", "answer_policy_v3", "answer_policy_v4", "answer_policy_v5"]
    },
    "pending_clarification": {
      "$ref": "#/$defs/PendingClarification"
    },
    "revalidation_context": {
      "$ref": "#/$defs/RevalidationContext"
    },
    "stream": {
      "type": "boolean",
      "default": true
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ConversationMessage"
      }
    },
    "source_filters": {
      "$ref": "#/$defs/SourceFilters"
    },
    "response_overrides": {
      "$ref": "#/$defs/ResponseOverrides"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "answer_mode": {
            "const": "revalidate"
          }
        },
        "required": ["answer_mode"]
      },
      "then": {
        "required": ["revalidation_context"]
      }
    },
    {
      "if": {
        "required": ["answer_policy_version"]
      },
      "then": {
        "properties": {
          "intent": {
            "enum": ["context_routing_required", "knowledge_query"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["pending_clarification"]
      },
      "then": {
        "required": ["answer_policy_version"],
        "properties": {
          "intent": {
            "enum": ["context_routing_required", "knowledge_query"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["answer_policy_version"],
        "properties": {
          "answer_policy_version": {"const": "answer_policy_v1"}
        }
      },
      "then": {
        "required": ["response_overrides"],
        "properties": {
          "response_overrides": {
            "required": ["system_prompt_version"],
            "properties": {
              "system_prompt_version": {"const": "prompt_v8"}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["answer_policy_version"],
        "properties": {
          "answer_policy_version": {"const": "answer_policy_v3"}
        }
      },
      "then": {
        "required": ["response_overrides"],
        "properties": {
          "response_overrides": {
            "required": ["system_prompt_version"],
            "properties": {
              "system_prompt_version": {"const": "prompt_v10"}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["answer_policy_version"],
        "properties": {
          "answer_policy_version": {"const": "answer_policy_v2"}
        }
      },
      "then": {
        "required": ["response_overrides"],
        "properties": {
          "response_overrides": {
            "required": ["system_prompt_version"],
            "properties": {
              "system_prompt_version": {"const": "prompt_v9"}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["answer_policy_version"],
        "properties": {
          "answer_policy_version": {"const": "answer_policy_v4"}
        }
      },
      "then": {
        "required": ["response_overrides"],
        "properties": {
          "response_overrides": {
            "required": ["system_prompt_version"],
            "properties": {
              "system_prompt_version": {"const": "prompt_v11"}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["answer_policy_version"],
        "properties": {
          "answer_policy_version": {"const": "answer_policy_v5"}
        }
      },
      "then": {
        "required": ["response_overrides"],
        "properties": {
          "response_overrides": {
            "required": ["system_prompt_version"],
            "properties": {
              "system_prompt_version": {"const": "prompt_v12"}
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "KnowledgeScope": {
      "type": "object",
      "required": ["snapshot_id", "manifest_hash", "revision_ids", "resolved_at"],
      "properties": {
        "snapshot_id": {
          "type": "string"
        },
        "manifest_hash": {
          "type": "string"
        },
        "revision_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "resolved_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "RevalidationContext": {
      "type": "object",
      "required": [
        "original_message_id",
        "original_snapshot_id",
        "original_answer",
        "original_citation_revision_ids",
        "related_update_event_ids"
      ],
      "properties": {
        "original_message_id": {
          "type": "string"
        },
        "original_snapshot_id": {
          "type": "string"
        },
        "original_answer": {
          "type": "string"
        },
        "original_citation_revision_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "related_update_event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "PendingClarification": {
      "type": "object",
      "required": ["clarification_id", "state_version", "original_user_message_id", "original_query", "missing_dimensions", "question", "turn_count"],
      "properties": {
        "clarification_id": {"type": "string", "minLength": 1},
        "state_version": {"type": "integer", "minimum": 1},
        "original_user_message_id": {"type": "string", "minLength": 1},
        "original_query": {"type": "string", "minLength": 1, "maxLength": 600},
        "missing_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "question": {"type": "string", "minLength": 1, "maxLength": 600},
        "turn_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "ConversationMessage": {
      "type": "object",
      "required": [
        "message_id",
        "role",
        "content"
      ],
      "properties": {
        "message_id": {"type": "string", "minLength": 1},
        "role": {
          "type": "string",
          "enum": [
            "system",
            "user",
            "assistant"
          ]
        },
        "content": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "SourceFilters": {
      "type": "object",
      "properties": {
        "file_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "source_formats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "txt",
              "md",
              "json",
              "pdf",
              "docx",
              "xlsx",
              "pptx"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "ResponseOverrides": {
      "type": "object",
      "properties": {
        "system_prompt_version": {
          "type": "string",
          "enum": [
            "prompt_v1",
            "prompt_v2",
            "prompt_v3",
            "prompt_v4",
            "prompt_v5",
            "prompt_v6",
            "prompt_v7",
            "prompt_v8",
            "prompt_v9",
            "prompt_v10",
            "prompt_v11",
            "prompt_v12"
          ]
        },
        "response_style": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "type": "number"
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "top_k": {
          "type": "integer",
          "minimum": 1
        },
        "retrieval_strategy": {
          "type": "string",
          "enum": ["lexical_compat_v1", "native_dense_v1"]
        },
        "embedding_model": {
          "type": "string",
          "minLength": 1
        },
        "rerank_enabled": {
          "type": "boolean"
        },
        "evidence_min_score": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
